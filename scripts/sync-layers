#!/usr/bin/env python3
"""Keep package layers aligned with the official package manifest."""

from pathlib import Path

root = Path(__file__).resolve().parents[1]
manifest = root / "packages/pacman.txt"
layers_dir = root / "packages/layers"
layer_names = ("core", "desktop", "development", "optional")

packages = set(manifest.read_text().splitlines())
owners = {}

for layer in layer_names:
    path = layers_dir / f"{layer}.txt"
    for package in path.read_text().splitlines() if path.exists() else ():
        if package in owners:
            raise SystemExit(f"package appears in two layers: {package}")
        owners[package] = layer

for package in packages - owners.keys():
    owners[package] = "optional"

layers_dir.mkdir(parents=True, exist_ok=True)
for layer in layer_names:
    path = layers_dir / f"{layer}.txt"
    entries = sorted(package for package, owner in owners.items()
                     if owner == layer and package in packages)
    path.write_text("".join(f"{package}\n" for package in entries))

print(f"synced {len(packages)} packages across {len(layer_names)} layers")
