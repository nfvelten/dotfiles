[Unit]
Description=Minimal Yerba Mate desktop shell
After=graphical-session.target

[Service]
# Software rendering: ~35 MB less RSS; the shell only draws flat panels and fades.
Environment=QT_QUICK_BACKEND=software
ExecStart=/usr/bin/quickshell -c default
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
