;;; test_org_bridge.el --- Capture checks -*- lexical-binding: t; -*-
(require 'ert)
(load (expand-file-name "org-bridge.el" (file-name-directory load-file-name)) nil t)
(ert-deftest capture-preserves-sections-and-rejects-unsaved ()
  (let* ((org-directory (make-temp-file "yerba-org-test" t))
         (file (expand-file-name "today.org" org-directory)))
    (cl-letf (((symbol-function 'nf/daily-note)
               (lambda () (find-file file))))
      (with-temp-file file (insert "#+title: Hoje\n* Dia\n*** Tasks: #personal\n- [ ] Existente\n\n*** Tasks: #work\n- [ ] Trabalho\n"))
      (yerba-org-capture "Teste com \"aspas\" e ç")
      (with-current-buffer (find-file-noselect file)
        (should (string-match-p "- \\[ \\] Existente\n\n- \\[ \\] Teste com \"aspas\" e ç\n\\*\\*\\* Tasks: #work" (buffer-string)))
        (goto-char (point-max))
        (insert "não salvo")
        (should-error (yerba-org-capture "Não inserir"))
        (should-not (string-match-p "Não inserir" (buffer-string)))
        (set-buffer-modified-p nil)
        (kill-buffer)))))
(ert-run-tests-batch-and-exit)
