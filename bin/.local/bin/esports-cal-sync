def fetch_liquipedia(game: str) -> str | None:
    """Try MediaWiki API — returns HTML text or None on failure."""
    url = (
        f"https://liquipedia.net/{game}/api.php"
        f"?action=parse&page=Portal:Tournaments&prop=text&format=json"
    )
    try:
        req = Request(url, headers=HEADERS)
        with urlopen(req, timeout=15) as r:
            data = json.loads(r.read().decode())
            return data.get("parse", {}).get("text", {}).get("*", "")
    except Exception:
        return None


def parse_liquipedia_tournaments(html: str) -> list[tuple]:
    """Extract (name, start, end, desc) from Liquipedia portal HTML."""
    events = []
    # Match rows in tournament tables: date range + name + prizepool
    for m in re.finditer(
        r'(\d{4}-\d{2}-\d{2})\s*[–\-]\s*(\d{4}-\d{2}-\d{2}).*?'
        r'title="([^"]+)"[^>]*>.*?\$\s*([\d,]+)',
        html, re.DOTALL
    ):
        try:
            start = date.fromisoformat(m.group(1))
            end   = date.fromisoformat(m.group(2))
            name  = m.group(3).strip()
            prize = int(m.group(4).replace(",", ""))
            if prize >= 500_000:
                events.append((name, start, end, f"${prize:,}"))
        except (ValueError, AttributeError):
            continue
    return events


def write_ics(uid: str, summary: str, start: date, end: date, description: str) -> None:
    from datetime import timedelta
    end_excl = end + timedelta(days=1)
    path = OUTPUT_DIR / f"{uid}.ics"
    lines = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//esports-cal-sync//EN",
        "BEGIN:VEVENT",
        f"UID:{uid}",
        f"SUMMARY:{summary}",
        f"DTSTART;VALUE=DATE:{start.strftime('%Y%m%d')}",
        f"DTEND;VALUE=DATE:{end_excl.strftime('%Y%m%d')}",
        f"DESCRIPTION:{description}",
        "END:VEVENT",
        "END:VCALENDAR",
    ]
    path.write_text("\n".join(lines))
    print(f"  {path.name}: {start} → {end}  {summary}")


def make_uid(game: str, name: str, start: date) -> str:
    import hashlib
    key = f"{game}-{name}-{start}"
    return hashlib.md5(key.encode()).hexdigest() + f"@{game}"


def sync_game(game: str, emoji_prefix: str) -> None:
    print(f"{game.upper()}...")
    written = set()

    # Try live Liquipedia data first
    html = fetch_liquipedia(game)
    if html:
        live = parse_liquipedia_tournaments(html)
        if live:
            for name, start, end, desc in live:
                uid = make_uid(game, name, start)
                write_ics(uid, f"{emoji_prefix} {name}", start, end, desc)
                written.add(uid)

    # Fill in hardcoded events not covered by live data
    for summary, start, end, desc in EVENTS.get(game, {}).get(YEAR, []):
        uid = make_uid(game, summary, start)
        if uid not in written:
            write_ics(uid, summary, start, end, desc)
            written.add(uid)

    if not html or not live:
        print(f"{game}: live source unavailable; using hardcoded events")
        return True

    # Clean up stale files for this game
    for f in OUTPUT_DIR.glob(f"*@{game}.ics"):
        if f.stem not in written:
            f.unlink()
    return True


if __name__ == "__main__":
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    results = [sync_game("dota2", "🎮"), sync_game("cs2", "🔫")]
    print("esports-cal-sync done.")
    raise SystemExit(0 if all(results) else 1)
