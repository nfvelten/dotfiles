#!/bin/bash
set -u

# The user service owns the only daemon instance. Starting another daemon here
# creates competing MPRIS/Web API sessions and makes playback appear stale.
if ! systemctl --user is-active --quiet spotify-player.service; then
    systemctl --user start spotify-player.service
fi

if hyprctl clients -j | jq -e '.[] | select(.workspace.name == "special:spotify")' > /dev/null 2>&1; then
    "$(dirname "$0")/hypr-toggle-special" spotify
    "$(dirname "$0")/scratchpad-center" __scratchspotify
else
    # The daemon is the single notification source; the visible TUI must not
    # emit a second toast for the same track change.
    ghostty --title=__scratchspotify --font-size=11 -e spotify_player -o enable_notify=false >/dev/null 2>&1 &
    sleep 0.5
    "$(dirname "$0")/hypr-toggle-special" spotify
    "$(dirname "$0")/scratchpad-center" __scratchspotify
fi
