#!/bin/bash
if hyprctl clients -j | jq -e '.[] | select(.workspace.name == "special:spotify")' > /dev/null 2>&1; then
    "$(dirname "$0")/hypr-toggle-special" spotify
    "$(dirname "$0")/scratchpad-center" __scratchspotify
else
    ghostty --title=__scratchspotify --font-size=11 -e spotify_player >/dev/null 2>&1 &
    sleep 0.5
    "$(dirname "$0")/hypr-toggle-special" spotify
    "$(dirname "$0")/scratchpad-center" __scratchspotify
fi
