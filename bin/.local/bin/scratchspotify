#!/bin/bash
if hyprctl clients -j | jq -e '.[] | select(.workspace.name == "special:spotify")' > /dev/null 2>&1; then
    hyprctl dispatch "hl.dsp.workspace.toggle_special(\"spotify\")"
else
    hyprctl dispatch "hl.dsp.exec_cmd(\"ghostty --title=__scratchspotify --font-size=11 -e spotify_player\")"
    sleep 0.5
    hyprctl dispatch "hl.dsp.workspace.toggle_special(\"spotify\")"
fi
