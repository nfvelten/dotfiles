#!/usr/bin/env bash
VAULT="${AMPHORA_VAULT:-$HOME/amphora}"

if hyprctl clients -j | jq -e '.[] | select(.workspace.name == "special:claude-amphora")' > /dev/null 2>&1; then
    hyprctl dispatch togglespecialworkspace claude-amphora
else
    hyprctl dispatch exec "[workspace special:claude-amphora silent;float;size 1100 640;center] ghostty --font-size=11 --working-directory=$VAULT -e bash -c 'exec $HOME/.local/bin/claude'"
    sleep 0.5
    hyprctl dispatch togglespecialworkspace claude-amphora
fi
