#!/usr/bin/env bash
set -euo pipefail

# Nightly: move commits you already made off the machine. Never stages or
# commits; review and commit by hand, this only reports and pushes.

report() {
  local dir=$1 dirty ahead
  [[ -d "$dir/.git" ]] || return 0
  dirty=$(git -C "$dir" status --porcelain | wc -l)
  ahead=$(git -C "$dir" rev-list --count '@{upstream}..HEAD' 2>/dev/null || echo "?")
  printf '%s: %s uncommitted, %s unpushed\n' "$dir" "$dirty" "$ahead"
}

report "$HOME/code/personal/dotfiles"
report "$HOME/org"

# The vault's remote is private; dotfiles is public, so its push stays manual.
git -C "$HOME/org" push --quiet origin HEAD || printf 'push failed %s\n' "$HOME/org" >&2
