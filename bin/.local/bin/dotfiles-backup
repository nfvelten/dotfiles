#!/usr/bin/env bash
set -euo pipefail

commit_repo() {
  local dir=$1 message=$2
  [[ -d "$dir/.git" ]] || return 0
  git -C "$dir" add -A
  git -C "$dir" diff --cached --quiet && return 0
  git -C "$dir" commit -m "$message" >/dev/null
  printf 'saved %s\n' "$dir"
}

commit_repo "$HOME/code/personal/dotfiles" "chore: save desktop configuration"
commit_repo "$HOME/org" "chore: save org vault"

# The vault has a private remote; dotfiles is public and stays a manual push.
git -C "$HOME/org" push --quiet origin HEAD || printf 'push failed %s\n' "$HOME/org" >&2
