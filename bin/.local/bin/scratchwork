#!/bin/bash
if hyprctl clients -j | jq -e '.[] | select(.workspace.name == "special:work-nvim")' > /dev/null 2>&1; then
    "$(dirname "$0")/hypr-toggle-special" work-nvim
    "$(dirname "$0")/scratchpad-center" __scratchwork
else
    ghostty --title=__scratchwork --font-size=11 --working-directory=/home/nfvelten/code/work -e nvim . >/dev/null 2>&1 &
    sleep 0.5
    "$(dirname "$0")/hypr-toggle-special" work-nvim
    "$(dirname "$0")/scratchpad-center" __scratchwork
fi
