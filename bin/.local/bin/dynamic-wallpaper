#!/usr/bin/env bash
set -euo pipefail

wallpaper_dir="$HOME/.local/share/backgrounds/cliffs"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/desktop"
current="$state_dir/background"
hour=$(date +%-H)

pick="$wallpaper_dir/$hour.jpg"
if [[ ! -f $pick ]]; then
    pick=$(find "$wallpaper_dir" -maxdepth 1 -type f -name '*.jpg' -printf '%f\n' | sort -n | awk -v h="$hour" '$1+0 <= h {file=$0} END {if (file) print file}')
    [[ -n $pick ]] && pick="$wallpaper_dir/$pick"
fi
[[ -f ${pick:-} ]] || exit 0

mkdir -p "$state_dir"
if [[ $(readlink -f "$current" 2>/dev/null || true) == "$pick" ]]; then
    systemctl --user is-active --quiet desktop-wallpaper.service && exit 0
fi
ln -sfn "$pick" "$current"
systemctl --user restart desktop-wallpaper.service
