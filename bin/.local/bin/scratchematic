#!/usr/bin/env bash
set -eu

if ! hyprctl clients -j | jq -e '.[] | select(.title == "__emacsnote")' >/dev/null; then
    ghostty --title=__emacsnote -e emacsclient --socket-name=default -nw --eval '(nf/daily-note)' >/dev/null 2>&1 &
    for ((i=0; i<40; i++)); do
        if hyprctl clients -j | jq -e '.[] | select(.title == "__emacsnote")' >/dev/null; then break; fi
        sleep 0.1
    done
fi
# Hyprland 0.56 ignores workspace animation overrides for special workspaces.
# The offset is chosen synchronously at dispatch; restore the default afterward.
hyprctl eval '
    hl.animation({leaf="specialWorkspace", enabled=true, speed=6, bezier="smooth", style="slidefade right 50%"})
    hl.dispatch(hl.dsp.workspace.toggle_special("emacsnote"))
    hl.animation({leaf="specialWorkspace", enabled=true, speed=6, bezier="smooth", style="slidefadevert 25"})
' >/dev/null
window=$(hyprctl activewindow -j)
[[ $(jq -r '.title // empty' <<<"$window") == __emacsnote ]] || exit 0
# Recalculate geometry when toggled on another monitor.
read -r width height x y < <(hyprctl monitors -j | jq -r --argjson win "$window" '
    .[] | select(.id == $win.monitor) |
    (.width / .scale) as $w | (.height / .scale) as $h |
    ($w * 0.44 | floor) as $pw | ($h * 0.90 | floor) as $ph |
    "\($pw) \($ph) \(.x + $w - $pw - 28 | floor) \(.y + ($h - $ph) / 2 | floor)"')
hyprctl eval "hl.dispatch(hl.dsp.window.resize({x=$width,y=$height,window=\"title:^__emacsnote$\"}))" >/dev/null
hyprctl eval "hl.dispatch(hl.dsp.window.move({x=$x,y=$y,relative=false,window=\"title:^__emacsnote$\"}))" >/dev/null
