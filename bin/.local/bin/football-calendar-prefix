#!/usr/bin/env python3
"""Prefix football calendar event summaries with a soccer emoji."""

from pathlib import Path


CALENDARS = {
    "sports_football": "⚽",
    "sports_ucl": "⚽",
    "sports_pl": "⚽",
    "sports_laliga": "⚽",
    "sports_seriea": "⚽",
    "sports_bundesliga": "⚽",
}


def prefix_file(path: Path, emoji: str) -> bool:
    marker = b"SUMMARY:"
    emoji_bytes = emoji.encode("utf-8")
    prefix = marker + emoji_bytes + b" "

    lines = path.read_bytes().splitlines(keepends=True)
    changed = False
    out = []

    for line in lines:
        if line.startswith(marker):
            summary = line[len(marker):]
            if not summary.startswith(emoji_bytes):
                line = prefix + summary
                changed = True
        out.append(line)

    if changed:
        path.write_bytes(b"".join(out))
    return changed


def main() -> None:
    base = Path.home() / ".local/share/khal/calendars"
    scanned = 0
    updated = 0

    for calendar, emoji in CALENDARS.items():
        calendar_dir = base / calendar
        if not calendar_dir.exists():
            continue
        for path in calendar_dir.glob("*.ics"):
            scanned += 1
            if prefix_file(path, emoji):
                updated += 1

    print(f"football-calendar-prefix: {updated}/{scanned} files updated")


if __name__ == "__main__":
    main()
